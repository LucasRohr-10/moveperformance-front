# Base URL of the NestJS API (moveperformance-back runs on port 4000 locally).
# No trailing slash needed. Login calls {NEXT_PUBLIC_API_URL}/api/auth/sign-in/email.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Better Auth — placeholders only. Not consumed yet; required once the auth
# integration ticket wires Better Auth in.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
